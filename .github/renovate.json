{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["* 0-9 1-7,15-21,29-31 * 1"],
  "timezone": "America/New_York",
  "updateNotScheduled": true,
  "commitMessageSuffix": "({{{baseBranch}}})",
  "helm-values": {
    "enabled": false
  },
  "npm": {
    "enabled": false
  },
  "dockerfile": {
    "managerFilePatterns": ["build/Dockerfile.rhtap"],
    "includePaths": ["build/Dockerfile.rhtap"],
    "pinDigests": true
  },
  "gomod": {
    "packageRules": [
      {
        "matchDepTypes": ["indirect"],
        "enabled": false
      }
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "commitMessageSuffix": "[SECURITY] ({{{baseBranch}}})"
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "enabled": false
    },
    {
      "groupName": "Containerfile images",
      "matchManagers": ["dockerfile"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub actions"
    }
  ]
}
